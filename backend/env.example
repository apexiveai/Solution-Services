APP_NAME=ApexiveAI Enterprise Operations Platform
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8010
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://aeop_user:change_this_password@127.0.0.1:5433/aeop_db

# Keycloak / OIDC
OIDC_ISSUER=https://auth.example.com/realms/apexiveai
OIDC_AUDIENCE=aeop-api
OIDC_JWKS_URL=https://auth.example.com/realms/apexiveai/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256

# Development only. Keep false in production.
DEV_CREATE_TABLES=false
