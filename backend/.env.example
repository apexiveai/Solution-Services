APP_NAME=ApexiveAI Enterprise Operations Platform
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8010
LOG_LEVEL=INFO

# AEOP PHASE 2 - KEYCLOAK JWT
AEOP_JWKS_URL=https://YOUR-AUTH-DOMAIN/realms/YOUR-REALM/protocol/openid-connect/certs
AEOP_JWT_ISSUER=https://YOUR-AUTH-DOMAIN/realms/YOUR-REALM
AEOP_JWT_AUDIENCE=YOUR-API-CLIENT-ID

DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/aeop_db
OIDC_ISSUER=https://auth.example.com/realms/apexiveai
OIDC_AUDIENCE=aeop-api
OIDC_JWKS_URL=https://auth.example.com/realms/apexiveai/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256
DEV_CREATE_TABLES=true

# Stable, high-entropy key for the encrypted Cyclone RPA credential vault (32+ characters).
# Provision this through a secret manager in production; never commit the real value.
AEOP_AUTOMATION_CREDENTIAL_KEY=